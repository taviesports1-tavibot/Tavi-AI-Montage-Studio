FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY lib ./lib
COPY video-worker ./video-worker

ENV NODE_ENV=production
ENV WORKER_HOST=0.0.0.0
ENV PORT=8788
ENV STORAGE_ROOT=/data

EXPOSE 8788
VOLUME ["/data"]

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
  CMD ["node", "-e", "const port=process.env.WORKER_PORT||process.env.PORT||8788;fetch(`http://127.0.0.1:${port}/health`).then((response)=>{if(!response.ok)process.exit(1)}).catch(()=>process.exit(1))"]

CMD ["node", "--import", "tsx", "video-worker/src/server.ts"]
