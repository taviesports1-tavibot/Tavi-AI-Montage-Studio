# Web app -> long-running video worker
NEXT_PUBLIC_MONTAGE_API_URL=http://localhost:8788

# Worker networking
WORKER_HOST=0.0.0.0
WORKER_PORT=8788
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4173

# Local MVP storage. Replace LocalStorageProvider for S3/R2/Blob later.
STORAGE_ROOT=.studio-data
TEMP_FILE_TTL_HOURS=24

# Upload limits
MAX_CLIPS=10
MAX_CLIP_MB=250
MAX_MUSIC_MB=40
MAX_CLIP_DURATION_SECONDS=180
MAX_QUEUE_DEPTH=3

# Public MVP abuse protection. Status polling remains within the global budget.
RATE_LIMIT_MAX_PER_15_MINUTES=1200
UPLOAD_RATE_LIMIT_PER_HOUR=10
RERENDER_RATE_LIMIT_PER_HOUR=20

# FFmpeg
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
RENDER_WIDTH=1080
RENDER_HEIGHT=1920
RENDER_FPS=30
X264_PRESET=veryfast
X264_CRF=20
